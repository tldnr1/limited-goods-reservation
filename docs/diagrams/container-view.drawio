        <mxCell id="clients" value="&lt;b&gt;API 사용자&lt;/b&gt;&lt;br&gt;&lt;br&gt;판매자 · 구매자&lt;br&gt;브라우저 UI 없음&lt;br&gt;OpenAPI / HTTP 호출&lt;br&gt;X-User-Id는 임시 경계" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="165" height="210" as="geometry"/></mxCell>
